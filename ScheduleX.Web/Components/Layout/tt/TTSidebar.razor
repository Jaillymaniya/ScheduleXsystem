@inject NavigationManager Nav

<div class="tt-nav">

    <!-- BRAND -->
    <div class="tt-brand"
         @onclick='@(()=>Navigate("/tt/overview"))'>

        <div class="logo">
            <img src="images/logo.png"
                 alt="ScheduleX Logo" />
        </div>

    </div>

    <!-- DASHBOARD -->
    <div class="tt-nav-section">
        Dashboard
    </div>

    <button type="button"
            class="@GetNavClass("/tt/overview")"
            @onclick='@(()=>Navigate("/tt/overview"))'>

        Overview

    </button>

    <!-- ACADEMIC SETUP -->
    <div class="tt-nav-section">
        Academic Setup
    </div>

    @* <button type="button"
            class="@GetNavClass("/tt/semesters")"
            @onclick='@(()=>Navigate("/tt/semesters"))'>

        Semesters

    </button> *@

    <button type="button"
            class="@GetNavClass("/tt/academic/faculty")"
            @onclick='@(()=>Navigate("/tt/academic/faculty"))'>

        Faculty

    </button>

    @* <button type="button"
            class="@GetNavClass("/tt/academic/subject")"
            @onclick='@(()=>Navigate("/tt/academic/subject"))'>

        Subjects & Assign

    </button> *@

    @* <button type="button" *@
    @*         class="@GetNavClass("/tt/room-management")" *@
    @*         @onclick='@(()=>Navigate("/tt/room-management"))'> *@

    @*     Rooms/Labs *@

    @* </button> *@

    <button type="button"
            class="@GetNavClass("/tt/academic/rooms")"
            @onclick='@(()=>Navigate("/tt/academic/rooms"))'>

        Rooms/Labs

    </button>

   


    <button type="button"
            class="@GetNavClass("/tt/academic/divisions")"
            @onclick='@(()=>Navigate("/tt/academic/divisions"))'>

        Divisions

    </button>
    <button type="button"
            class="@GetNavClass("/tt/academic/subject-mapping")"
            @onclick='@(()=>Navigate("/tt/academic/subject-mapping"))'>

        Subject-Mapping Settings

    </button>

    <!-- CONFIGURATION -->
    <div class="tt-nav-section">
        Configuration
    </div>

    <button type="button"
            class="@GetNavClass("/tt/Configuration/schedule-configuration")"
            @onclick='@(()=>Navigate("/tt/Configuration/schedule-configuration"))'>

        Timetable Settings

    </button>

    <button type="button"
            class="@GetNavClass("/tt/Configuration/templates")"
            @onclick='@(()=>Navigate("/tt/Configuration/templates"))'>

        Template Configuration

    </button>

    <!-- GENERATION -->
    <div class="tt-nav-section">
        Generation
    </div>

    <button type="button"
            class="@GetNavClass("/tt/generate")"
            @onclick='@(()=>Navigate("/tt/generate"))'>

        Generate Timetable

    </button>

    @* <button type="button"
            class="@GetNavClass("/tt/validation")"
            @onclick='@(()=>Navigate("/tt/validation"))'>

        Conflicts / Validation

    </button> *@

    <!-- VIEW & EXPORT -->
    <div class="tt-nav-section">
        View & Export
    </div>

    <button type="button"
            class="@GetNavClass("/tt/view")"
            @onclick='@(()=>Navigate("/tt/view"))'>

        View Timetable

    </button>

    @* <button type="button"
            class="@GetNavClass("/tt/export")"
            @onclick='@(()=>Navigate("/tt/export"))'>

        Export (PDF/Excel)

    </button> *@

</div>

@code {

    void Navigate(string url)
    {
        Nav.NavigateTo(url);
    }

    string GetNavClass(string url)
    {
        var currentUrl =
            "/" + Nav.ToBaseRelativePath(Nav.Uri);

        return currentUrl.Equals(
            url,
            StringComparison.OrdinalIgnoreCase)
            ? "tt-nav-item active"
            : "tt-nav-item";
    }
}