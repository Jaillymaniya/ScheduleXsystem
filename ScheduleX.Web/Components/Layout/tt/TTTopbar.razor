@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@using ScheduleX.Core.Entities
@using ScheduleX.Infrastructure.Data
@using ScheduleX.Web.Services

@inject NavigationManager Nav
@inject AppDbContext Db
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject TTSessionState SessionState

<div class="tt-topbar-inner compact-topbar">

    <!-- LEFT -->
    <div class="tt-topbar-left compact-left">

        <div class="tt-title">
            TT Coordinator Dashboard
        </div>

        <div class="tt-subtitle">
            Manage setup • configure • generate • export
        </div>

    </div>

    <!-- CENTER -->
    <div class="tt-topbar-center compact-center">

        <!-- Academic Year -->
        <div class="tt-select-wrap compact-select">

            <label class="tt-select-label">
                Academic Year
            </label>

            <select class="tt-select compact-input"
                    @bind="SelectedAcademicYearId">

                @foreach (var year in AcademicYears)
                {
                    <option value="@year.AcademicYearId">
                        @year.YearName
                    </option>
                }

            </select>

        </div>

        <!-- Course -->
        <div class="tt-select-wrap compact-select">

            <label class="tt-select-label">
                Course
            </label>

            <select class="tt-select compact-input"
                    @bind="SelectedCourseId">

                @foreach (var course in Courses)
                {
                    <option value="@course.CourseId">
                        @course.CourseName
                    </option>
                }

            </select>

        </div>

        <!-- TERM -->
        <div class="tt-select-wrap compact-select">

            <label class="tt-select-label">
                Term
            </label>

            <select class="tt-select compact-input"
                    @bind="SelectedAcademicTermId">

                @foreach (var term in AcademicTerms)
                {
                    <option value="@term.AcademicTermId">
                        @term.TermType
                    </option>
                }

            </select>

        </div>

    </div>

    <!-- RIGHT -->
    <div class="tt-topbar-right compact-right">

        <button class="tt-btn ghost small-btn"
                @onclick="@(()=>Nav.NavigateTo("/tt/account/profile"))">
            Profile
        </button>

        <button class="tt-btn ghost small-btn"
                @onclick="@(()=>Nav.NavigateTo("/tt/account/change-password"))">
            Change Password
        </button>

        <form method="post"
              action="/api/auth/logout"
              data-enhance="false"
              style="display:inline;">

            <button type="submit"
                    class="tt-btn danger small-btn">
                Logout
            </button>

        </form>

    </div>

</div>

@code {

    private List<AcademicYear> AcademicYears = new();

    private List<Course> Courses = new();

    private List<AcademicTerm> AcademicTerms = new();

    // =========================
    // ACADEMIC YEAR
    // =========================

    private int _selectedAcademicYearId;

    private int SelectedAcademicYearId
    {
        get => _selectedAcademicYearId;

        set
        {
            if (_selectedAcademicYearId != value)
            {
                _selectedAcademicYearId = value;

                var selectedYear = AcademicYears
                    .FirstOrDefault(x => x.AcademicYearId == value);

                SessionState.AcademicYearId = value;

                SessionState.AcademicYearName =
                    selectedYear?.YearName;

                LoadAcademicTerms();

                if (AcademicTerms.Any())
                {
                    SelectedAcademicTermId =
                        AcademicTerms.First().AcademicTermId;
                }
            }
        }
    }

    // =========================
    // COURSE
    // =========================

    private int _selectedCourseId;

    private int SelectedCourseId
    {
        get => _selectedCourseId;

        set
        {
            if (_selectedCourseId != value)
            {
                _selectedCourseId = value;

                var selectedCourse = Courses
                    .FirstOrDefault(x => x.CourseId == value);

                SessionState.CourseId = value;

                SessionState.CourseName =
                    selectedCourse?.CourseName;

                LoadAcademicTerms();

                if (AcademicTerms.Any())
                {
                    SelectedAcademicTermId =
                        AcademicTerms.First().AcademicTermId;
                }
            }
        }
    }

    // =========================
    // TERM
    // =========================

    private int _selectedAcademicTermId;

    private int SelectedAcademicTermId
    {
        get => _selectedAcademicTermId;

        set
        {
            if (_selectedAcademicTermId != value)
            {
                _selectedAcademicTermId = value;

                var selectedTerm = AcademicTerms
                    .FirstOrDefault(x => x.AcademicTermId == value);

                SessionState.AcademicTermId = value;

                SessionState.TermName =
                    selectedTerm?.TermType.ToString();
            }
        }
    }

    // =========================
    // LOAD TERMS
    // =========================

    private void LoadAcademicTerms()
    {
        if (_selectedAcademicYearId <= 0 || _selectedCourseId <= 0)
        {
            AcademicTerms.Clear();
            return;
        }

        AcademicTerms = Db.AcademicTerms
            .Where(x =>
                x.AcademicYearId == _selectedAcademicYearId &&
                x.CourseId == _selectedCourseId)
            .OrderBy(x => x.TermType)
            .ToList();
    }

    // =========================
    // LOAD DATA
    // =========================

    protected override async Task OnInitializedAsync()
    {
        // Academic Years
        AcademicYears = await Db.AcademicYears
            .Where(x => x.IsActive)
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync();

        // Logged in user
        var authState =
            await AuthProvider.GetAuthenticationStateAsync();

        var user =
            await UserManager.GetUserAsync(authState.User);

        // Load assigned courses
        if (user != null)
        {
            Courses = await Db.TTCoordinatorCourses
                .Where(x => x.UserId == user.Id)
                .Select(x => x.Course)
                .Where(x => x.IsActive)
                .Distinct()
                .ToListAsync();
        }

        // Default Academic Year
        if (AcademicYears.Any())
        {
            SelectedAcademicYearId =
                AcademicYears.First().AcademicYearId;
        }

        // Default Course
        if (Courses.Any())
        {
            SelectedCourseId =
                Courses.First().CourseId;
        }

        // Default Term
        if (AcademicTerms.Any())
        {
            SelectedAcademicTermId =
                AcademicTerms.First().AcademicTermId;
        }
    }
}