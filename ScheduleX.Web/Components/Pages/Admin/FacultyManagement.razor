@if (showForm)
{
    <div class="modal-backdrop">
        <div class="modal-box form-card">

            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @* <h3 class="form-title"> *@
                @*     @(model.FacultyId == 0 ? "Add Faculty" : "Edit Faculty") *@
                @* </h3> *@

                <div class="form-grid">

                    <InputText class="form-control" placeholder="Name *" @bind-Value="model.FacultyName" />

                    <InputText class="form-control" placeholder="Code" @bind-Value="model.FacultyCode" />

                    <InputText class="form-control" placeholder="Email" @bind-Value="model.Email" />

                    <InputText class="form-control" maxlength="10"  placeholder="Phone (10 digits)" @bind-Value="model.Phone" />

                    <div class="form-group">
                        <label>Department *</label>
                    <InputSelect class="form-control" @bind-Value="model.DepartmentId">
                        <option value="">Select Department</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.DepartmentId">@d.DepartmentName</option>
                        }
                    </InputSelect>
                    </div>

                    <div class="checkbox-row">
                        <InputCheckbox @bind-Value="model.IsExternal" />
                        <label>External Faculty</label>
                    </div>

                    <InputNumber class="form-control"
                                 @bind-Value="model.MaxLecturesPerDay"
                                 placeholder="Max Lectures" />

                </div>

                <div class="modal-actions">
                    <button type="submit" class="btn-success">Save</button>
                    <button type="button" class="btn-cancel" @onclick="Close">Cancel</button>
                </div>

            </EditForm>

        </div>
    </div>
}

@if (showToast)
{
    <div class="toast @toastType">
        @toastMessage
    </div>
}

@code {

    // List<Faculty> list = new();
    List<Department> departments = new();
    // Faculty model = new();

    List<Faculty> list = new();
    // List<Department> departments = new();
    Faculty model = new();

    List<Faculty> uploadedFaculty = new();
    List<string> csvErrors = new();

    bool showToast = false;
    string toastMessage = "";
    string toastType = "success";

    bool showForm = false;

    int fileInputKey = 0;

    protected override async Task OnInitializedAsync()
    {
        list = await FacultyService.GetAllAsync();
        departments = await DepartmentService.GetAllAsync();
    }

    void OpenForm()
    {
        model = new Faculty();
        showForm = true;
    }

    void Close()
    {
        showForm = false;
    }

    void Edit(Faculty f)
    {
        model = new Faculty
            {
                FacultyId = f.FacultyId,
                FacultyName = f.FacultyName,
                FacultyCode = f.FacultyCode,
                Email = f.Email,
                Phone = f.Phone,
                DepartmentId = f.DepartmentId,
                IsExternal = f.IsExternal,
                MaxLecturesPerDay = f.MaxLecturesPerDay,
                IsActive = f.IsActive
            };

        showForm = true;
    }

    async Task Save()
    {
        // (bool success, string message) result;

        // if (model.FacultyId == 0)
        //     result = await FacultyService.CreateAsync(model);
        // else
        //     result = await FacultyService.UpdateAsync(model);

        // if (result.success)
        // {
        //     list = await FacultyService.GetAllAsync();
        //     showForm = false;
        // }
        (bool success, string message) result;

        if (model.FacultyId == 0)
            result = await FacultyService.CreateAsync(model);
        else
            result = await FacultyService.UpdateAsync(model);

        await ShowToast(result.message, result.success);

        if (result.success)
        {
            list = await FacultyService.GetAllAsync();
            showForm = false;
        }
    }

    async Task ToggleStatus(Faculty f)
    {
        var result = await FacultyService.ToggleStatusAsync(f.FacultyId);

        await ShowToast(result.message, result.success);

        if (result.success)
            list = await FacultyService.GetAllAsync();
    }

    async Task ShowToast(string message, bool success = true)
    {
        toastMessage = message;
        toastType = success ? "success" : "error";
        showToast = true;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(2500);

        showToast = false;

        await InvokeAsync(StateHasChanged);
    }

    async Task UploadCsv(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var ms = new MemoryStream();

            await stream.CopyToAsync(ms);

            var content = Encoding.UTF8.GetString(ms.ToArray());

            var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);

            var rows = new List<string[]>();

            foreach (var line in lines)
            {
                rows.Add(line.Split(','));
            }

            var result = FacultyCsvValidator.Validate(
    rows.Skip(1).ToList(),
    departments
    );

            uploadedFaculty = result.valid;
            csvErrors = result.errors;

            await ShowToast(
                result.errors.Any() ? "CSV has errors" : "CSV valid",
                result.errors.Any()
            );
        }
        catch (Exception ex)
        {
            await ShowToast(ex.Message, true);
        }
    }

    async Task SaveCsv()
    {
        var result = await FacultyService.BulkUpload(uploadedFaculty);

        await ShowToast(result.Item2, !result.Item1);

        if (result.Item1)
        {
            list = await FacultyService.GetAllAsync();
            uploadedFaculty.Clear();

            fileInputKey++; // 🔥 resets file input
        }
    }

    async Task DownloadTemplate()
{
    var bytes = FacultyCsvValidator.GenerateFacultyTemplate();
    var base64 = Convert.ToBase64String(bytes);

    await JS.InvokeVoidAsync("downloadFile", "FacultyTemplate.csv", base64);
}
}