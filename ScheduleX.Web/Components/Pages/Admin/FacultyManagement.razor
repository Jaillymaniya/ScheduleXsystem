<div class="faculty-toolbar">

    <button class="btn btn-primary" @onclick="OpenForm">
        + Add Faculty
    </button>

    <button class="btn btn-template" @onclick="DownloadTemplate">
        ⬇ Download Template
    </button>

    <label class="file-upload">
        📁 Choose CSV
        <InputFile @key="fileInputKey" OnChange="UploadCsv" class="hidden-file" />
    </label>

    <button class="btn btn-save"
            @onclick="SaveCsv"
            disabled="@(uploadedFaculty.Count == 0)">
        💾 Save CSV
    </button>

</div>

<div class="page-container">
    <div class="table-header">
        @* <h2 class="form-title">Faculty Management</h2> *@
        @* <button class="btn btn-primary">+ Add Faculty</button> *@
    </div>

    <div class="table-wrapper">
<table class="styled-table"> 
    <thead>
        <tr>
            <th>Name</th> 
            <th>Department</th>
            <th>Max Lecture Per Day</th>
             <th>External</th> 
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
         @foreach (var f in list)
        {
            <tr>
                <td>@f.FacultyName</td>
                <td>@f.Department?.DepartmentName</td>
                <td>@f.MaxLecturesPerDay</td>
                <td>@(f.IsExternal ? "Yes" : "No")</td>
                <td>@(f.IsActive ? "Active" : "Inactive")</td>
                <td>
                            <div class="action-buttons">
                            <button class="btn-icon btn-edit" @onclick="() => Edit(f)">Edit</button>

                      
                    @if (f.IsActive)
                    {
                        <button class="btn-danger" @onclick="() => ToggleStatus(f)">Deactivate</button>
                    }
                    else
                    {
                        <button class="btn-success" @onclick="() => ToggleStatus(f)">Activate</button>
                    }
                </div>
                </td>
            </tr>
        }
    </tbody>
</table>
    </div>
</div>

