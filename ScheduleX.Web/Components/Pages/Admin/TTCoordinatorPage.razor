


@rendermode InteractiveServer
@page "/admin/ttcoordinator"

@using ScheduleX.Core.Entities
@using ScheduleX.Core.Interfaces.Admin
@using ScheduleX.Core.Interfaces

<link href="css/admin/tt.css" rel="stylesheet" />

@inject ITTCoordinatorService Service
@inject IDepartmentRepository DeptRepo
@inject ICourseRepository CourseRepo

@using ScheduleX.Web.Components.Layout.Admin
@layout AdminLayout

<h3>TT Coordinator Management</h3>

<button class="btn btn-success mb-3" @onclick="ShowForm">+ Add</button>

@if (showForm)
{
    <div class="card p-3 mb-3">

        <EditForm Model="model" OnValidSubmit="HandleSubmit">

            <DataAnnotationsValidator />

            <div class="mb-2">
                <InputText class="form-control"
                           @bind-Value="model.FullName"
                           placeholder="Full Name" />
            </div>

            <div class="mb-2">
                <InputText class="form-control"
                           @bind-Value="model.UserName"
                           placeholder="Username" />
            </div>

            <div class="mb-2">
                <InputText class="form-control"
                           @bind-Value="model.Email"
                           placeholder="Email" />
            </div>

            <div class="mb-2">
                <InputText class="form-control"
                           @bind-Value="model.PhoneNumber"
                           placeholder="Phone" />
            </div>

            <!-- Department -->
            <div class="mb-2">

                <select class="form-control"
                        value="@model.DepartmentId"
                        @onchange="OnDepartmentChanged">

                    <option value="">Select Department</option>

                    @foreach (var d in departments)
                    {
                        <option value="@d.DepartmentId">
                            @d.DepartmentName
                        </option>
                    }

                </select>

            </div>

            <!-- Courses -->
            <div class="mb-2">

                <label>Select Courses</label>

                <p>Total Courses: @courses.Count</p>

                @foreach (var c in courses)
                {
                    <div class="form-check">

                        <input class="form-check-input"
                               type="checkbox"
                               @bind="c.IsSelected" />

                        <label class="form-check-label">
                            @c.CourseName
                        </label>

                    </div>
                }

            </div>

            @if (isNew)
            {
                <div class="mb-2">

                    <InputText class="form-control"
                               @bind-Value="password"
                               type="password"
                               placeholder="Password" />

                </div>
            }

            <button type="submit"
                    class="btn btn-primary me-2">
                Save
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="Cancel">
                Cancel
            </button>

        </EditForm>

    </div>
}

