@code {

    List<User> users = new();

    List<Department> departments = new();

    List<Course> courses = new();

    List<int> selectedCourseIds = new();

    User model = new();

    string password = "";

    bool showForm = false;

    bool isNew = true;

    bool showToast;

    string toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        departments = await DeptRepo.GetAllAsync();
    }

    async Task LoadData()
    {
        users = await Service.GetAllAsync();
    }

    void ShowForm()
    {
        model = new User();

        password = "";

        selectedCourseIds.Clear();

        courses.Clear();

        isNew = true;

        showForm = true;
    }

    async Task OnDepartmentChanged(ChangeEventArgs e)
    {
        selectedCourseIds.Clear();

        courses.Clear();

        var value = e.Value?.ToString();

        if (!string.IsNullOrEmpty(value))
        {
            int departmentId = Convert.ToInt32(value);

            model.DepartmentId = departmentId;

            courses = await CourseRepo
                .GetByDepartmentAsync(departmentId);
        }

        await InvokeAsync(StateHasChanged);
    }

    void ToggleCourse(ChangeEventArgs e, int courseId)
    {
        var isChecked = e.Value != null;

        if (isChecked)
        {
            if (!selectedCourseIds.Contains(courseId))
            {
                selectedCourseIds.Add(courseId);
            }
        }
        else
        {
            selectedCourseIds.Remove(courseId);
        }
    }

    // void Edit(User u)
    // {
    //     model = new User
    //         {
    //             Id = u.Id,
    //             FullName = u.FullName,
    //             UserName = u.UserName,
    //             Email = u.Email,
    //             PhoneNumber = u.PhoneNumber,
    //             DepartmentId = u.DepartmentId
    //         };

    //     isNew = false;

    //     showForm = true;
    // }

    async Task Edit(User u)
    {
        model = new User
            {
                Id = u.Id,
                FullName = u.FullName,
                UserName = u.UserName,
                Email = u.Email,
                PhoneNumber = u.PhoneNumber,
                DepartmentId = u.DepartmentId
            };

        isNew = false;

        if (u.DepartmentId != null)
        {
            courses = await CourseRepo
                .GetByDepartmentAsync(u.DepartmentId.Value);

            selectedCourseIds = u.TTCoordinatorCourses
                .Where(x => x.IsActive)
                .Select(x => x.CourseId)
                .ToList();

            foreach (var course in courses)
            {
                course.IsSelected =
                    selectedCourseIds.Contains(course.CourseId);
            }
        }

        showForm = true;

        StateHasChanged();
    }

    async Task HandleSubmit()
    {
        selectedCourseIds = courses
        .Where(x => x.IsSelected)
        .Select(x => x.CourseId)
        .ToList();
        if (string.IsNullOrWhiteSpace(model.FullName))
        {
            await ShowToast("Full Name is required");
            return;
        }

        if (string.IsNullOrWhiteSpace(model.UserName))
        {
            await ShowToast("Username is required");
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            await ShowToast("Email is required");
            return;
        }

        if (string.IsNullOrWhiteSpace(model.PhoneNumber))
        {
            await ShowToast("Phone is required");
            return;
        }

        if (model.DepartmentId == null)
        {
            await ShowToast("Department is required");
            return;
        }

        if (selectedCourseIds.Count == 0)
        {
            await ShowToast("Please select at least one course");
            return;
        }

        if (isNew && string.IsNullOrWhiteSpace(password))
        {
            await ShowToast("Password is required");
            return;
        }

        await Save();
    }


    async Task Save()
    {
        if (isNew)
        {
            var (success, message) =
                await Service.CreateAsync(
                    model,
                    password,
                    selectedCourseIds);

            await ShowToast(message);

            if (success)
            {
                await LoadData();

                showForm = false;
            }
        }
        else
        {
            // await Service.UpdateAsync(model);
            await Service.UpdateAsync(model, selectedCourseIds);

            await ShowToast("Updated successfully");

            await LoadData();

            showForm = false;
        }
    }

    async Task Deactivate(int id)
    {
        await Service.SoftDeleteAsync(id);

        await ShowToast("Deactivated successfully");

        await LoadData();
    }

    async Task Activate(int id)
    {
        await Service.ActivateAsync(id);

        await ShowToast("Activated successfully");

        await LoadData();
    }

    void Cancel()
    {
        showForm = false;
    }

    async Task ShowToast(string msg)
    {
        toastMessage = msg;

        showToast = true;

        StateHasChanged();

        await Task.Delay(2000);

        showToast = false;

        StateHasChanged();
    }
}