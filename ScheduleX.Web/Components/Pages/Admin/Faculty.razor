@page "/admin/faculty"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using ScheduleX.Web.Components.Layout.Admin
@layout AdminLayout

@using FacultyEntity = ScheduleX.Core.Entities.Faculty
@using ScheduleX.Web.Services.Admin
@using System.Text

@inject FacultyApiService FacultyService
@inject DepartmentApiService DepartmentService
@inject IJSRuntime JS

<link href="/css/admin/faculty.css" rel="stylesheet" />

<h2>Faculty Management</h2>

<button class="btn-primary" @onclick="OpenForm">+ Add Faculty</button>

<div class="page-container">
    <div class="table-header">
        <h2 class="form-title">Faculty Management</h2>
        <button class="btn btn-primary">+ Add Faculty</button>
    </div>

    <div class="table-wrapper">
<table class="styled-table"> 
    <thead>
        <tr>
            <th>Name</th> 
            <th>Department</th>
             <th>External</th> 
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
         @foreach (var f in list)
        {
            <tr>
                <td>@f.FacultyName</td>
                <td>@f.Department?.DepartmentName</td>
                <td>@(f.IsExternal ? "Yes" : "No")</td>
                <td>@(f.IsActive ? "Active" : "Inactive")</td>
                <td>
                            <button class="btn-icon btn-edit" @onclick="() => Edit(f)">Edit</button>

                    @if (f.IsActive)
                    {
                        <button class="btn-danger" @onclick="() => ToggleStatus(f)">Deactivate</button>
                    }
                    else
                    {
                        <button class="btn-success" @onclick="() => ToggleStatus(f)">Activate</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
    </div>
</div>

