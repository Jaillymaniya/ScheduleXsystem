@page "/admin/change-password"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@using ScheduleX.Web.Components.Layout.Admin
@layout AdminLayout

@using ScheduleX.Web.DTOs.Account

@inject ProfileService ProfileService

<link href="/css/admin/change-password.css" rel="stylesheet" />

<div class="profile-page">

    <div class="page-header">
        <h3>Change Password</h3>
    </div>

    <div class="card">

        <div class="avatar">
            🔒
        </div>

        <EditForm Model="model" OnValidSubmit="UpdatePassword">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Current Password</label>
                <div class="input-group">
                    <InputText type="@(_showCurrent ? "text" : "password")"
                               class="form-control"
                               @bind-Value="model.CurrentPassword" />

                    <span class="eye-btn" @onclick="() => _showCurrent = !_showCurrent">
                        <i class="@(_showCurrent ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                    </span>
                </div>
                <ValidationMessage For="@(() => model.CurrentPassword)" />
            </div>

            <div class="form-group">
                <label>New Password</label>
                <div class="input-group">
                    <InputText type="@(_showNew ? "text" : "password")"
                               class="form-control"
                               @bind-Value="model.NewPassword" />

                    <span class="eye-btn" @onclick="() => _showNew = !_showNew">
                        <i class="@(_showNew ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                    </span>
                </div>
                <ValidationMessage For="@(() => model.NewPassword)" />
            </div>

            <div class="form-group">
                <label>Confirm Password</label>
                <div class="input-group">
                    <InputText type="@(_showConfirm ? "text" : "password")"
                               class="form-control"
                               @bind-Value="model.ConfirmPassword" />

                    <span class="eye-btn" @onclick="() => _showConfirm = !_showConfirm">
                        <i class="@(_showConfirm ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                    </span>
                </div>
                <ValidationMessage For="@(() => model.ConfirmPassword)" />
            </div>

            <button type="submit" class="btn-primary">Update Password</button>
        </EditForm>

    </div>

</div>

@if (showToast)
{
    <div class="toast-container">
        <div class="toast-message">
            @toastMessage
            <div class="toast-progress"></div>
        </div>
    </div>
}

@code {

    private ChangePasswordDto model = new();
    bool _showCurrent = false;
    bool _showNew = false;
    bool _showConfirm = false;
    bool showToast = false;
    string toastMessage = "";

    private async Task UpdatePassword()
    {
        var result = await ProfileService.UpdatePasswordAsync(model);

        ShowToast(result.Message);

        if (result.Success)
        {
            model = new(); // clear form
        }
    }

    async void ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;

        await Task.Delay(3000);

        showToast = false;
        StateHasChanged();
    }
}