@page "/tt/overview"
@layout ScheduleX.Web.Components.Layout.tt.TTLayout
@inject NavigationManager Nav
@inject TTOverviewService _overviewService
@inject TTSessionState SessionState
@using Microsoft.AspNetCore.Authorization
@using ScheduleX.Web.Services
@attribute [Authorize(Roles = "TTCoordinator")]


<link href="css/tt.css" rel="stylesheet" />
<link href="css/tt/tt-overview.css" rel="stylesheet" />

<div class="tt-overview">

    <div class="tt-page-head">
        <div>
            <h2 class="tt-h2">Overview</h2>
            <p class="tt-muted">Your complete timetable workflow at one place.</p>
        </div>

        <div class="tt-head-actions">
            <button class="tt-btn" @onclick='() => Nav.NavigateTo("/tt/settings")'>
                Configure Settings
            </button>

            <button class="tt-btn primary" @onclick='() => Nav.NavigateTo("/tt/generate")'>
                Generate Now
            </button>
        </div>
    </div>

    <div class="tt-grid-4">

        <div class="tt-card clickable" @onclick='() => Nav.NavigateTo("/tt/faculty")'>
            <div class="tt-card-top">
                <div class="tt-card-title">Faculty</div>
                <div class="tt-pill">FR8</div>
            </div>
            <div class="tt-muted">
                Total Active: @totalFaculty | Available: @availableFaculty
            </div>
        </div>

        <div class="tt-card clickable" @onclick='() => Nav.NavigateTo("/tt/subjects")'>
            <div class="tt-card-top">
                <div class="tt-card-title">Subjects</div>
                <div class="tt-pill">FR9</div>
            </div>
            <div class="tt-muted">
                Total Active Subjects: @totalSubjects
            </div>
        </div>

        <div class="tt-card clickable" @onclick='() => Nav.NavigateTo("/tt/rooms")'>
            <div class="tt-card-top">
                <div class="tt-card-title">Rooms / Labs</div>
                <div class="tt-pill">FR10</div>
            </div>
            <div class="tt-muted">
                Total Active Rooms/Labs: @totalRooms
            </div>
        </div>

    </div>

</div>

@code {

    int totalFaculty;
    int availableFaculty;
    int totalSubjects;
    int totalRooms;
    int totalSemesters;

    private bool _isLoading;

    protected override void OnInitialized()
    {
        SessionState.OnChange += Reload;
    }

    private async Task Reload()
    {
        await LoadData();
        StateHasChanged();
    }

    public void Dispose()
    {
        SessionState.OnChange -= Reload;
    }

    private async Task LoadData()
    {
        if (_isLoading) return;

        if (!SessionState.CourseId.HasValue ||
            !SessionState.AcademicTermId.HasValue ||
            !SessionState.AcademicYearId.HasValue)
        {
            totalFaculty = 0;
            availableFaculty = 0;
            totalSubjects = 0;
            totalRooms = 0;
            return;
        }

        _isLoading = true;

        try
        {
            var result = await _overviewService.GetOverview(
                SessionState.CourseId.Value,
                SessionState.AcademicTermId.Value,
                SessionState.AcademicYearId.Value
            );

            totalFaculty = result.TotalFaculty;
            availableFaculty = result.AvailableFaculty;
            totalSubjects = result.TotalSubjects;
            totalRooms = result.TotalRooms;
        }
        finally
        {
            _isLoading = false;
        }
    }
}