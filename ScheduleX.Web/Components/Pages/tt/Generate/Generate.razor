@page "/tt/Generate/generate"
@using ScheduleX.Web.Components.Layout.tt
@layout TTLayout
@attribute [Authorize(Roles = "TTCoordinator")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ScheduleX.Core.Entities
@using ScheduleX.Web.DTOs
@using ScheduleX.Web.Services
@using ScheduleX.Web.Services.TimeTable
@using ScheduleX.Core.Interfaces.TTCoordinator

@inject ITimeTableService TimeTableService
@inject ITimetableRepository TimetableRepository
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TTSessionState TTSessionState

<link href="/css/tt/tt-generate.css" rel="stylesheet" />

<PageTitle>Generate Timetable</PageTitle>

<div class="generate-page">

    @if (!string.IsNullOrWhiteSpace(ToastMessage))
    {
        <div class="toast-container">
            <div class="toast-message @(IsSuccess ? "success" : "danger")">
                @ToastMessage
            </div>
        </div>
    }

    <div class="page-header">
        <h3>Generate Timetable</h3>
    </div>

    <!-- SESSION INFO -->
    <div class="tt-card">
        <div class="form-grid">

            <div>
                <label>Academic Year</label>
                <input class="tt-input"
                       value="@TTSessionState.AcademicYearName"
                       readonly />
            </div>

            <div>
                <label>Course</label>
                <input class="tt-input"
                       value="@TTSessionState.CourseName"
                       readonly />
            </div>

            <div>
                <label>Term</label>
                <input class="tt-input"
                       value="@TTSessionState.TermName"
                       readonly />
            </div>

            <div>
                <label>Template</label>

                <InputSelect class="tt-select"
                             @bind-Value="Model.TemplateId">
                    <option value="0">Select Template</option>

                    @foreach (var item in Templates)
                    {
                        <option value="@item.TemplateId">
                            @item.TemplateName
                        </option>
                    }
                </InputSelect>
            </div>

        </div>

        <div style="margin-top:20px;">
            <button type="button"
                    class="btn btn-success"
                    disabled="@IsLoading"
                    @onclick="GenerateTimetable">
                @(IsLoading ? "Generating..." : "Generate Timetable")
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="tt-card">
            <h5>Generating timetable...</h5>

            <div class="progress">
                <div class="progress-bar"
                     style="width:@Progress">
                    @Progress
                </div>
            </div>
        </div>
    }

    @if (PreviewData.Any())
    {
        <div class="tt-card">
            <h5>Generated Preview</h5>

           <ViewTimetablePreviewGrid
    Data="SelectedEntries"
    Style="CurrentStyle" />
        </div>
    }

</div>

@code {
    private GenerateTTDto Model = new();

    private List<TimeTableTemplate> Templates = new();
    private List<PreviewDto> PreviewData = new();

    private bool IsLoading = false;
    private bool IsSuccess = false;

    private string ToastMessage = "";
    private string Progress = "0%";

    private int CurrentUserId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();

        Templates = await TimetableRepository.GetTemplatesAsync();

        SyncSessionValues();

        TTSessionState.OnChange += HandleSessionChanged;
    }

    private async Task LoadCurrentUser()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);

            if (idClaim != null)
            {
                int.TryParse(idClaim.Value, out CurrentUserId);
            }
        }
    }

    private void SyncSessionValues()
    {
        Model.AcademicYearId = TTSessionState.AcademicYearId ?? 0;
        Model.CourseId = TTSessionState.CourseId ?? 0;
        Model.AcademicTermId = TTSessionState.AcademicTermId ?? 0;
    }

    private async Task HandleSessionChanged()
    {
        SyncSessionValues();

        PreviewData.Clear();
        ToastMessage = "";

        await InvokeAsync(StateHasChanged);
    }

    private async Task GenerateTimetable()
    {
        try
        {
            SyncSessionValues();

            ToastMessage = "";
            PreviewData.Clear();

            if (Model.AcademicYearId <= 0 ||
                Model.CourseId <= 0 ||
                Model.AcademicTermId <= 0)
            {
                IsSuccess = false;
                ToastMessage =
                    "Please select Academic Year, Course and Term from top bar.";
                return;
            }

            if (Model.TemplateId <= 0)
            {
                IsSuccess = false;
                ToastMessage = "Please select timetable template.";
                return;
            }

            Model.UserId = CurrentUserId;

            IsLoading = true;

            Progress = "15%";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(250);

            Progress = "40%";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(250);

            Progress = "70%";
            await InvokeAsync(StateHasChanged);

            var result = await TimeTableService.GenerateAsync(Model);

            Progress = "90%";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(250);

            if (result.Success)
            {
                PreviewData = result.Preview;
                IsSuccess = true;
                ToastMessage = result.Message;
            }
            else
            {
                IsSuccess = false;
                ToastMessage = result.Message;
            }

            Progress = "100%";
        }
        catch (Exception ex)
        {
            IsSuccess = false;
            ToastMessage = ex.Message;
        }
        finally
        {
            await Task.Delay(400);

            IsLoading = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        TTSessionState.OnChange -= HandleSessionChanged;
    }
}