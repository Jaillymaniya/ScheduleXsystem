@page "/tt/account/change-password"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "TTCoordinator")]

@using ScheduleX.Web.Components.Layout.tt
@layout TTLayout

@using ScheduleX.Web.DTOs.Account

@inject ProfileService ProfileService

<link href="/css/tt/tt-change-password.css" rel="stylesheet" />

<div class="tt-content">

    <div class="tt-page-head">
        <div>
            <h2 class="tt-h2">Change Password</h2>
            <p class="tt-muted">Secure your account credentials</p>
        </div>
    </div>

    <div class="tt-profile-wrapper">

        <div class="tt-card">

            <div class="tt-profile-avatar lock">
                🔒
            </div>

            <EditForm Model="model" OnValidSubmit="UpdatePassword">
                <DataAnnotationsValidator />

                <div class="tt-form-grid">

                    <div class="tt-field">
                        <label class="tt-label">Current Password</label>

                        <div class="tt-password-wrap">
                            <InputText type="@(_showCurrent ? "text" : "password")"
                                       class="tt-input"
                                       @bind-Value="model.CurrentPassword" />

                            <span class="tt-eye"
                                  @onclick="() => _showCurrent = !_showCurrent">
                                <i class="@(_showCurrent ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                            </span>
                        </div>

                        <ValidationMessage For="@(() => model.CurrentPassword)" />
                    </div>

                    <div class="tt-field">
                        <label class="tt-label">New Password</label>

                        <div class="tt-password-wrap">
                            <InputText type="@(_showNew ? "text" : "password")"
                                       class="tt-input"
                                       @bind-Value="model.NewPassword" />

                            <span class="tt-eye"
                                  @onclick="() => _showNew = !_showNew">
                                <i class="@(_showNew ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                            </span>
                        </div>

                        <ValidationMessage For="@(() => model.NewPassword)" />
                    </div>

                    <div class="tt-field">
                        <label class="tt-label">Confirm Password</label>

                        <div class="tt-password-wrap">
                            <InputText type="@(_showConfirm ? "text" : "password")"
                                       class="tt-input"
                                       @bind-Value="model.ConfirmPassword" />

                            <span class="tt-eye"
                                  @onclick="() => _showConfirm = !_showConfirm">
                                <i class="@(_showConfirm ? "fa-solid fa-eye-slash" : "fa-solid fa-eye")"></i>
                            </span>
                        </div>

                        <ValidationMessage For="@(() => model.ConfirmPassword)" />
                    </div>

                </div>

                <div class="tt-actions-row">
                    <button type="submit" class="tt-btn primary">
                        Update Password
                    </button>
                </div>

            </EditForm>

        </div>

    </div>

</div>

@if (showToast)
{
    <div class="toast-container">
        <div class="toast-message">
            @toastMessage
            <div class="toast-progress"></div>
        </div>
    </div>
}

@code {

    private ChangePasswordDto model = new();

    bool _showCurrent = false;
    bool _showNew = false;
    bool _showConfirm = false;

    bool showToast = false;
    string toastMessage = "";

    private async Task UpdatePassword()
    {
        var result = await ProfileService.UpdatePasswordAsync(model);

        ShowToast(result.Message);

        if (result.Success)
        {
            model = new();
        }
    }

    async void ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;

        await Task.Delay(3000);

        showToast = false;
        StateHasChanged();
    }
}