@page "/tt/Configuration/schedule-configuration"
@layout ScheduleX.Web.Components.Layout.tt.TTLayout
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using ScheduleX.Core.Entities
@using ScheduleX.Web.Services.TT
@using ScheduleX.Web.Services
@using ScheduleX.Infrastructure.Data
@inject AppDbContext Db

@inject ScheduleConfigService Service
@inject TTSessionState SessionState

<link href="css/tt/schedule-config.css" rel="stylesheet" />

<div class="schedule-page">
<div class="tt-page-head">

    <div>
        <h2 class="tt-h2">
            Timetable Settings
        </h2>

        <p class="tt-muted">
            Configure lecture timings and breaks
        </p>
    </div>

</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="tt-success">
        @message
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="tt-error">
        @errorMessage
    </div>
}

    <div class="schedule-card">

    <div class="schedule-grid-3">

        <!-- Academic Year -->

        <div>
                <label class="schedule-label">
                Academic Year
            </label>

                <input class="schedule-input"
                   value="@SessionState.AcademicYearName"
                   readonly />
        </div>

        <!-- Course -->

        <div>
            <label class="schedule-label">
                Course
            </label>

            <input class="schedule-input"
                   value="@SessionState.CourseName"
                   readonly />
        </div>

        <!-- Lecture Duration -->

        <div>
            <label class="schedule-label">
                Lecture Duration
            </label>

            <input type="number"
                   class="schedule-input"
                   @bind="model.LectureDurationMin" />
        </div>

        <!-- Start Time -->

        <div>
            <label class="schedule-label">
                Start Time
            </label>

            <input type="time"
                   class="schedule-input"
                   @bind="startTime" />
        </div>

        <!-- End Time -->

        <div>
            <label class="schedule-label">
                End Time
            </label>

            <input type="time"
                   class="schedule-input"
                   @bind="endTime" />
        </div>

        <!-- Lecture Per Day -->

        <div>
            <label class="schedule-label">
                Lectures Per Day
            </label>

            <input type="number"
                   class="schedule-input"
                   @bind="model.LecturesPerDay" />
        </div>

    </div>

    <!-- WORKING DAYS -->

    <div class="mt-4">

        <div class="schedule-label mb-2">
            Working Days
        </div>

        <div class="tt-days">

            <label>
                <input type="checkbox" @bind="days.Mon" />
                Monday
            </label>

            <label>
                <input type="checkbox" @bind="days.Tue" />
                Tuesday
            </label>

            <label>
                <input type="checkbox" @bind="days.Wed" />
                Wednesday
            </label>

            <label>
                <input type="checkbox" @bind="days.Thu" />
                Thursday
            </label>

            <label>
                <input type="checkbox" @bind="days.Fri" />
                Friday
            </label>

            <label>
                <input type="checkbox" @bind="days.Sat" />
                Saturday
            </label>

            <label>
                <input type="checkbox" @bind="days.Sun" />
                Sunday
            </label>

        </div>

    </div>

    <div class="mt-4">

            <button class="schedule-btn schedule-btn-primary"
                @onclick="SaveConfig">

            Save Configuration

        </button>

    </div>

</div>

<!-- BREAK RULES -->
@if (model.ConfigId > 0)
{
    <div class="schedule-card mt-4">

        <h4 class="mb-3">
            Break Rules
        </h4>

        <div class="tt-grid-4">

            <label class="schedule-label">Break No</label>
            <input type="number"
                   class="schedule-input"
                   placeholder="Break No"
                   @bind="breakModel.BreakNo" />

            <label class="schedule-label">Break Name</label>
            <input class="schedule-input"
                   placeholder="Break Name"
                   @bind="breakModel.BreakName" />

            <label class="schedule-label">After Lecture No</label>
            <input type="number"
                   class="schedule-input"
                   placeholder="After Lecture"
                   min="0"
                   @bind="breakModel.AfterLectureNo" />

            <label class="schedule-label">Break Duration (Min)</label>
            <input type="number"
                   class="schedule-input"
                   placeholder="Duration"
                   min="0"
                   @bind="breakModel.BreakDurationMin" />

        </div>

        <div class="mt-3">

            @if (!isEditingBreak)
            {
                    <button class="schedule-btn schedule-btn-success"
                        @onclick="AddBreak">

                    Add Break

                </button>
            }
            else
            {
                <button class="schedule-btn schedule-btn-primary"
                        @onclick="UpdateBreak">

                    Update Break

                </button>

                    <button class="schedule-btn schedule-btn-danger ms-2"
                        @onclick="CancelEdit">

                    Cancel

                </button>
            }

        </div>

    </div>

    <!-- BREAK TABLE -->

    <div class="schedule-card mt-4">

        <table class="schedule-table">

            <thead>
                <tr>
                    <th>No</th>
                    <th>Name</th>
                    <th>After Lecture</th>
                    <th>Duration</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var b in breaks)
                {
                    <tr>

                        <td>@b.BreakNo</td>

                        <td>@b.BreakName</td>

                        <td>@b.AfterLectureNo</td>

                        <td>@b.BreakDurationMin min</td>

                        <td>

                            <button class="schedule-btn schedule-btn-primary"
                                    @onclick="() => EditBreak(b)">

                                Edit

                            </button>

                            <button class="schedule-btn schedule-btn-danger ms-2"
                                    @onclick="() => DeleteBreak(b.BreakRuleId)">

                                Delete

                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="schedule-card">
        <h5>Time Slot Preview</h5>
        <button class="schedule-btn schedule-btn-warning mb-3" @onclick="GenerateSlots">Generate Slots</button>

        @* <table class="table table-striped table-bordered"> *@
        <table class="schedule-table">
            <thead>
                <tr>
                    <th>Slot No</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Type</th>
                    <th>Break Name</th>
                </tr>
            </thead>
            <tbody>
                @if (slots.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center">No slots generated.</td>
                    </tr>
                }
                else
                {
                    @foreach (var s in slots)
                    {
                        <tr>
                            <td>@s.SlotNo</td>
                            <td>@s.StartTime</td>
                            <td>@s.EndTime</td>
                            <td>@(s.SlotType == SlotTypeEnum.Lecture ? "Lecture" : "Break")</td>
                            <td>@s.BreakRule?.BreakName</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
</div>

@code {

    private ScheduleConfig model = new();

    private BreakRule breakModel = new();

    private List<BreakRule> breaks = new();

    private List<TimeSlot> slots = new();

    private string? message;

    private string? errorMessage;

    private bool isEditingBreak;

    private int editingBreakId;

    private TimeOnly startTime = new(9, 0);
    private TimeOnly endTime = new(14, 0);

    // =========================================

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    // =========================================

    private async Task LoadData()
    {
        if (SessionState.AcademicYearId <= 0 ||
            SessionState.CourseId <= 0)
        {
            errorMessage =
                "Please select academic year and course.";

            return;
        }

        var data = await Service.GetConfigAsync(
            SessionState.AcademicYearId ?? 0,
            SessionState.CourseId ?? 0);

        var selectedCourse = await Db.Courses
        .FirstOrDefaultAsync(x =>
        x.CourseId == (SessionState.CourseId ?? 0));

        int departmentId =
            selectedCourse?.DepartmentId ?? 0;

        if (data != null)
        {
            model = data;

            breaks = data.BreakRules
                .OrderBy(x => x.BreakNo)
                .ToList();

            slots = data.TimeSlots
                .OrderBy(x => x.SlotNo)
                .ToList();

            startTime = model.StartTime;
            endTime = model.EndTime;

            ApplyWorkingDaysMask(
                model.WorkingDaysMask);
        }
        else
        {
            model = new ScheduleConfig
                {
                    AcademicYearId =
                        SessionState.AcademicYearId ?? 0,

                    // DepartmentId =
                    //     SessionState.DepartmentId,
                    DepartmentId =
                        departmentId,

                    CourseId =
                        SessionState.CourseId,

                    StartTime =
                        TimeOnly.Parse("09:00"),

                    EndTime =
                        TimeOnly.Parse("14:00"),

                    LectureDurationMin = 60,

                    LecturesPerDay = 5,

                    IsActive = true
                };
        }
    }

    // =========================================

    private async Task SaveConfig()
    {
        try
        {
            errorMessage = null;

            message = null;

            model.AcademicYearId =
                SessionState.AcademicYearId ?? 0;

            var selectedCourse = await Db.Courses
                .FirstOrDefaultAsync(x =>
                 x.CourseId == (SessionState.CourseId ?? 0));

            model.DepartmentId =
                selectedCourse?.DepartmentId ?? 0;

            model.CourseId =
                SessionState.CourseId;

            model.StartTime = startTime;
            model.EndTime = endTime;

            model.WorkingDaysMask =
                GetWorkingDaysMask();

            model = await Service.SaveAsync(model);

            message =
                "Configuration saved successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // =========================================

    private async Task AddBreak()
    {
        breakModel.ConfigId = model.ConfigId;

        await Service.AddBreakRuleAsync(
            breakModel);

        breakModel = new BreakRule();

        breaks = await Service.GetBreakRulesAsync(
            model.ConfigId);
    }

    // =========================================

    private void EditBreak(BreakRule model)
    {
        breakModel = new BreakRule
            {
                BreakRuleId = model.BreakRuleId,
                ConfigId = model.ConfigId,
                BreakNo = model.BreakNo,
                BreakName = model.BreakName,
                AfterLectureNo = model.AfterLectureNo,
                BreakDurationMin = model.BreakDurationMin
            };

        editingBreakId = model.BreakRuleId;

        isEditingBreak = true;
    }

    // =========================================

    private async Task UpdateBreak()
    {
        breakModel.BreakRuleId = editingBreakId;

        await Service.UpdateBreakRuleAsync(
            breakModel);

        breaks = await Service.GetBreakRulesAsync(
            model.ConfigId);

        breakModel = new BreakRule();

        isEditingBreak = false;
    }

    // =========================================

    private async Task DeleteBreak(int id)
    {
        await Service.DeleteBreakRuleAsync(id);

        breaks = await Service.GetBreakRulesAsync(
            model.ConfigId);
    }

    // =========================================

    private void CancelEdit()
    {
        breakModel = new BreakRule();

        isEditingBreak = false;
    }

    // =========================================

    private int GetWorkingDaysMask()
    {
        int mask = 0;

        if (days.Mon) mask |= 1;
        if (days.Tue) mask |= 2;
        if (days.Wed) mask |= 4;
        if (days.Thu) mask |= 8;
        if (days.Fri) mask |= 16;
        if (days.Sat) mask |= 32;
        if (days.Sun) mask |= 64;

        return mask;
    }

    private void ApplyWorkingDaysMask(int mask)
    {
        days.Mon = (mask & 1) == 1;
        days.Tue = (mask & 2) == 2;
        days.Wed = (mask & 4) == 4;
        days.Thu = (mask & 8) == 8;
        days.Fri = (mask & 16) == 16;
        days.Sat = (mask & 32) == 32;
        days.Sun = (mask & 64) == 64;
    }

    private async Task GenerateSlots()
    {
        try
        {
            errorMessage = null;
            message = null;

            if (model.ConfigId <= 0)
            {
                errorMessage = "Please save configuration first.";
                return;
            }

            slots = await Service.GenerateSlotsAsync(model.ConfigId);

            message = "Time slots generated successfully.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // =========================================

    public class WorkingDaysVm
    {
        public bool Mon { get; set; }

        public bool Tue { get; set; }

        public bool Wed { get; set; }

        public bool Thu { get; set; }

        public bool Fri { get; set; }

        public bool Sat { get; set; }

        public bool Sun { get; set; }
    }

    private WorkingDaysVm days = new();
}