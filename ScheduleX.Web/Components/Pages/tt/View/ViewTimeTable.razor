@page "/tt/view"
@using ScheduleX.Web.Components.Layout.tt
@layout TTLayout
@attribute [Authorize(Roles = "TTCoordinator")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using ScheduleX.Web.DTOs
@using ScheduleX.Web.Services
@using ScheduleX.Web.Services.TT.TimeTable

@inject AuthenticationStateProvider AuthProvider
@inject TTSessionState TTSessionState
@inject IViewTimetableService ViewService
@inject IJSRuntime JS

<link href="/css/tt/tt-tt-view.css" rel="stylesheet" />

<PageTitle>View Timetable</PageTitle>

<div class="view-tt">

    <!-- HEADER -->
    <div class="view-tt-header">
        <div>
            <h2>Generated Timetables</h2>
            <p>Click any timetable batch to preview, download, or delete it</p>
        </div>
    </div>

    <!-- BATCHES -->
    @if (Batches.Any())
    {
        <div class="view-tt-batch-grid">

            @foreach (var batch in Batches)
            {
                <div class="view-tt-batch-card @(SelectedBatchId == batch.BatchId ? "view-tt-batch-card-active" : "")"
                     @onclick="() => SelectBatch(batch.BatchId)">

                    <div class="view-tt-batch-title">
                        @batch.Course
                    </div>

                    <div class="view-tt-batch-meta">
                        @batch.AcademicYear
                    </div>

                    <div class="view-tt-batch-meta">
                        @batch.Term
                    </div>

                    <div class="view-tt-batch-meta">
                        Template: @batch.TemplateName
                    </div>

                    <div class="view-tt-batch-meta">
                        Divisions: @batch.TotalDivisions
                    </div>

                    <div class="view-tt-batch-date">
                        @batch.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="view-tt-empty">
            No generated timetable batches found.
        </div>
    }

    <!-- DIVISION PILLS -->
    @if (ShowPreview && PreviewGroups.Any())
    {
        <div class="view-tt-pill-wrap">

            @foreach (var pill in PreviewGroups)
            {
                <button type="button"
                        class="view-tt-pill @(SelectedDivisionKey == pill.Key ? "view-tt-pill-active" : "")"
                        @onclick="() => SelectDivision(pill.Key)">
                    @pill.Semester - @pill.Division
                </button>
            }

        </div>
    }

    <!-- ACTION BAR -->
    @if (ShowPreview && SelectedBatchId > 0)
    {
        <div class="view-tt-action-bar">

            <button type="button"
                    class="view-tt-btn-success"
                    @onclick="DownloadExcel">
                Download Excel
            </button>

            <button type="button"
                    class="view-tt-btn-danger"
                    @onclick="DeleteBatch">
                Delete Timetable
            </button>

            <button type="button"
                    class="view-tt-btn-close"
                    @onclick="ClosePreview">
                Close Preview
            </button>

        </div>
    }

    <!-- PREVIEW -->
    @if (ShowPreview && SelectedEntries.Any())
    {
        <ViewTimetablePreviewGrid Data="SelectedEntries"
                                  Style="CurrentStyle" />
    }

</div>

@code {
    private int CurrentUserId;
    private int SelectedBatchId;
    private string SelectedDivisionKey = "";
    private bool ShowPreview = false;
    private bool IsLoading = false;
    private bool IsDownloading = false;
    private List<ViewBatchCardDto> Batches = new();
    private List<DivisionPreviewGroupDto> PreviewGroups = new();
    private List<PreviewDto> SelectedEntries = new();

    private Models.Template.TemplateStyle CurrentStyle = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        var id = user.FindFirst(ClaimTypes.NameIdentifier);

        if (id != null)
        {
            CurrentUserId = int.Parse(id.Value);
        }

        TTSessionState.OnChange += HandleSessionChanged;
        await LoadBatches();
    }

    private async Task HandleSessionChanged()
    {
        ClosePreview();

        Batches.Clear();

        await LoadBatches();

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadBatches()
    {
        if (!TTSessionState.AcademicYearId.HasValue ||
            !TTSessionState.CourseId.HasValue ||
            !TTSessionState.AcademicTermId.HasValue)
        {
            Batches.Clear();
            return;
        }

        var result = await ViewService.GetBatchesAsync(
            new LoadViewTimetableRequestDto
                {
                    UserId = CurrentUserId,
                    AcademicYearId = TTSessionState.AcademicYearId.Value,
                    CourseId = TTSessionState.CourseId.Value,
                    AcademicTermId = TTSessionState.AcademicTermId.Value
                });

        Batches = result.Batches ?? new List<ViewBatchCardDto>();
    }

    private async Task SelectBatch(int batchId)
    {
        if (IsLoading)
            return;

        IsLoading = true;

        try
        {
            SelectedBatchId = batchId;

            PreviewGroups.Clear();
            SelectedEntries.Clear();
            SelectedDivisionKey = "";
            ShowPreview = false;

            StateHasChanged();

            var result = await ViewService.GetBatchPreviewAsync(
                batchId,
                CurrentUserId);

            if (!result.Success)
                return;

            PreviewGroups = result.Groups ?? new();
            CurrentStyle = result.TemplateStyle ?? new();

            if (PreviewGroups.Any())
            {
                var first = PreviewGroups.First();

                SelectedDivisionKey = first.Key;
                SelectedEntries = first.Entries ?? new();
                ShowPreview = true;
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectDivision(string key)
    {
        SelectedDivisionKey = key;

        var selected = PreviewGroups.FirstOrDefault(x => x.Key == key);

        if (selected != null)
        {
            SelectedEntries = selected.Entries;
        }
    }

    private void ClosePreview()
    {
        ShowPreview = false;
        SelectedBatchId = 0;
        SelectedDivisionKey = "";

        PreviewGroups.Clear();
        SelectedEntries.Clear();
    }

    private async Task DownloadExcel()
    {
        if (IsDownloading)
            return;

        IsDownloading = true;

        try
        {
            var result = await ViewService.DownloadBatchAsync(
                SelectedBatchId,
                CurrentUserId);

            if (!result.Success || string.IsNullOrWhiteSpace(result.Base64))
                return;

            await JS.InvokeVoidAsync(
                "downloadFile",
                "Timetable.xlsx",
                result.Base64);
        }
        finally
        {
            IsDownloading = false;
        }
    }

    private async Task DeleteBatch()
    {
        var deleted = await ViewService.DeleteBatchAsync(
            SelectedBatchId,
            CurrentUserId);

        if (!deleted)
            return;

        Batches.RemoveAll(x => x.BatchId == SelectedBatchId);

        ClosePreview();

        StateHasChanged();
    }

    public void Dispose()
    {
        TTSessionState.OnChange -= HandleSessionChanged;
    }
}