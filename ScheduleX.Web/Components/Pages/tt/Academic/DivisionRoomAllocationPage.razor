        LoggedInUserId =
            Convert.ToInt32(
                user.FindFirst(
                    ClaimTypes.NameIdentifier)?.Value);

        await ReloadData();
    }

    private async Task ReloadData()
    {
        var courseId =
            SessionState.CourseId;

        var termId =
            SessionState.AcademicTermId;

        if (courseId == null
            || termId == null)
        {
            semesters = new();
            return;
        }

        semesters =
            await AllocationRepo
            .GetSemestersByCourseAsync(
                courseId.Value,
                termId.Value);

        divisions =
            await AllocationRepo
            .GetDivisionsAsync(
                LoggedInUserId);

        rooms =
            await AllocationRepo
            .GetRoomsAsync(
                LoggedInUserId);

        allocations =
            await AllocationRepo
            .GetAllAsync(

                LoggedInUserId,

                SessionState.AcademicYearId ?? 0,

                SessionState.CourseId ?? 0,

                SessionState.AcademicTermId ?? 0);

        allocation =
            new DivisionRoomAllocation();

        filteredDivisions =
            new();

        await InvokeAsync(StateHasChanged);
    }

    private void OnSemesterChanged(
        ChangeEventArgs e)
    {
        allocation.SemesterId =
            Convert.ToInt32(e.Value);

        filteredDivisions =
            divisions

            .Where(x =>
                x.SemesterId
                == allocation.SemesterId)

            .ToList();
    }

