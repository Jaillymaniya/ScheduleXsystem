    private async Task SaveAllocation()
    {
        try
        {

            allocation.AcademicTermId = SessionState.AcademicTermId.Value;

            if (allocation.SemesterId == 0
                || allocation.DivisionId == 0
                || allocation.RoomId == 0)
            {
                ShowToast(
                    "Please select all fields",
                    true);

                return;
            }

            // =========================
            // SAME DIVISION CHECK
            // =========================

            bool divisionExists =
                await AllocationRepo
                .DivisionAlreadyAllocatedAsync(
                    allocation.DivisionId,
                    editId);

            if (divisionExists)
            {
                ShowToast(
                    "Division already has room allocated",
                    true);

                return;
            }

            // =========================
            // ROOM CHECK OTHER SEMESTER
            // =========================

            var existingAllocation =
                await AllocationRepo
                .GetRoomAllocationAsync(
                    allocation.RoomId);

            if (existingAllocation != null
                &&
                existingAllocation.SemesterId
                != allocation.SemesterId
                &&
                existingAllocation.AllocationId
                != editId)
            {
                oldAllocationId =
                    existingAllocation.AllocationId;

                oldSemesterName =
                    $"Semester {existingAllocation.Semester.SemesterNo}";

                showDeallocateModal = true;

                StateHasChanged();

                return;
            }

            // =========================
            // SAME SEMESTER ROOM CHECK
            // =========================

            bool roomExists =
                await AllocationRepo
                .RoomAlreadyAllocatedAsync(
                    allocation.SemesterId,
                    allocation.RoomId,
                    editId);

            if (roomExists)
            {
                ShowToast(
                    "Room already assigned in this semester",
                    true);

                return;
            }

            allocation.AcademicTermId =
                SessionState.AcademicTermId ?? 0;

            if (!isEditMode)
            {
                await AllocationRepo
                    .AddAsync(allocation);
            }
            else
            {
                await AllocationRepo
                    .UpdateAsync(allocation);
            }

            await AllocationRepo
                .SaveAsync();

            ShowToast(
                isEditMode
                ? "Allocation updated successfully"
                : "Allocation added successfully",
                false);

            await ReloadData();

            isEditMode = false;
        }
        catch (Exception)
        {
            ShowToast(
                "Duplicate allocation not allowed",
                true);
        }
    }

    private async Task ConfirmDeallocation()
    {
        await AllocationRepo
            .DeleteAsync(oldAllocationId);

        await AllocationRepo
            .SaveAsync();

        allocation.AcademicTermId =
            SessionState.AcademicTermId ?? 0;

        await AllocationRepo
            .AddAsync(allocation);

        await AllocationRepo
            .SaveAsync();

        await ReloadData();

        showDeallocateModal = false;

        ShowToast(
            "Room reallocated successfully",
            false);
    }

    private void CloseModal()
    {
        showDeallocateModal = false;
    }

    private async Task EditAllocation(
        int id)
    {
        var data =
            await AllocationRepo
            .GetByIdAsync(id);

        if (data != null)
        {
            allocation = data;

            filteredDivisions =
                divisions

                .Where(x =>
                    x.SemesterId
                    == allocation.SemesterId)

                .ToList();

            editId = id;

            isEditMode = true;
        }
    }

    private async Task DeleteAllocation(
        int id)
    {
        await AllocationRepo
            .DeleteAsync(id);

        await AllocationRepo
            .SaveAsync();

        await ReloadData();

        ShowToast(
            "Allocation deleted successfully",
            false);
    }

    private void CancelEdit()
    {
        allocation =
            new DivisionRoomAllocation();

        filteredDivisions =
            new();

        isEditMode = false;
    }

    private async void ShowToast(
        string message,
        bool isError)
    {
        toastMessage = message;

        isErrorToast = isError;

        showToast = true;

        StateHasChanged();

        await Task.Delay(3000);

        showToast = false;

        await InvokeAsync(
            StateHasChanged);
    }

