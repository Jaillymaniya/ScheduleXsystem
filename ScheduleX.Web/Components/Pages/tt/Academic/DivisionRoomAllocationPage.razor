    private async Task SaveAllocation()
    {
        try
        {
            if (allocation.SemesterId == 0
                || allocation.DivisionId == 0
                || allocation.RoomId == 0)
            {
                ShowToast(
                    "Please select all fields",
                    true);

                return;
            }

     //        bool roomExists =
     // await AllocationRepo
     // .RoomAlreadyAllocatedAsync(
     //     allocation.SemesterId,
     //     allocation.RoomId,
     //     editId);

            bool roomExists =
           await AllocationRepo
           .RoomAlreadyAllocatedAsync(
               allocation.SemesterId,
               allocation.RoomId,
               editId);

            if (roomExists)
            {
                ShowToast(
                    "Room already assigned",
                    true);

                return;
            }


            if (!isEditMode)
            {
                await AllocationRepo
                    .AddAsync(allocation);
            }
            else
            {
                await AllocationRepo
                    .UpdateAsync(allocation);
            }

            await AllocationRepo
                .SaveAsync();

            ShowToast(
                isEditMode
                ? "Allocation updated successfully"
                : "Allocation added successfully",
                false);

            allocations =
                await AllocationRepo
                .GetAllAsync(
                    LoggedInUserId);

            allocation =
                new DivisionRoomAllocation();

            filteredDivisions =
                new();

            isEditMode = false;
        }
        catch (Exception)
        {
            ShowToast(
                "Duplicate allocation not allowed",
                true);
        }
    }


    private async Task EditAllocation(
        int id)
    {
        var data =
            await AllocationRepo
            .GetByIdAsync(id);

        if (data != null)
        {
            allocation = data;

            filteredDivisions =
                divisions

                .Where(x =>
                    x.SemesterId
                    == allocation.SemesterId)

                .ToList();

            editId = id;

            isEditMode = true;
        }
    }



    private async Task DeleteAllocation(
        int id)
    {
        await AllocationRepo
            .DeleteAsync(id);

        await AllocationRepo
            .SaveAsync();

        allocations =
            await AllocationRepo
            .GetAllAsync(
                LoggedInUserId);

        ShowToast(
            "Allocation deleted successfully",
            false);
    }



    private void CancelEdit()
    {
        allocation =
            new DivisionRoomAllocation();

        filteredDivisions =
            new();

        isEditMode = false;
    }



    private async void ShowToast(
        string message,
        bool isError)
    {
        toastMessage = message;

        isErrorToast = isError;

        showToast = true;

        StateHasChanged();

        await Task.Delay(3000);

        showToast = false;

        await InvokeAsync(
            StateHasChanged);
    }

    void GoBack()
    {
        try
        {
            Nav.NavigateTo(
                "/tt/academic/subject-mapping");
        }
        catch
        {
        }
    }

    void GoNext()
    {
        Nav.NavigateTo("/tt/Configuration/schedule-configuration");
    }
}