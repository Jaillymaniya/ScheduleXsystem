@page "/tt/academic/division-room-allocation"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ScheduleX.Core.Entities
@using ScheduleX.Core.Interfaces.TTCoordinator
@using System.Security.Claims
@inject NavigationManager Nav
@using ScheduleX.Web.Components.Layout.tt
@using ScheduleX.Web.Services
@inject TTSessionState SessionState
@layout TTLayout

@attribute [Authorize(Roles = "TTCoordinator")]

@inject IDivisionRoomAllocationRepository AllocationRepo
@inject AuthenticationStateProvider AuthStateProvider

<link href="/css/tt/division-room-allocation.css"
      rel="stylesheet" />

<div class="allocation-page">

    <h1 class="page-title">
        Division Room Allocation
    </h1>

    <div class="lecture-config-page">

        <div class="btn-section">

            <button type="button"
                    class="back-btn"
                    @onclick="GoBack">

                <i class="fas fa-arrow-left"></i>

                Back

            </button>

            <button type="button"
                    class="back-btn"
                    @onclick="GoNext">

                <i class="fas fa-arrow-right"></i>

                Next

            </button>

        </div>
    </div>
    <br/>

    <!-- FORM -->

    <div class="allocation-form-card">

        <div class="allocation-grid">

            <!-- SEMESTER -->

            <div class="form-group">

                <label>
                    Semester
                </label>

                <select class="form-control"
                        @onchange="OnSemesterChanged">

                    <option value="0">
                        Select Semester
                    </option>

                    @foreach (var semester in semesters)
                    {
                        <option value="@semester.SemesterId">

                            Semester
                            @semester.SemesterNo

                        </option>
                    }

                </select>

            </div>

            <!-- DIVISION -->

            <div class="form-group">

                <label>
                    Division
                </label>

                <select class="form-control"
                        @bind="allocation.DivisionId">

                    <option value="0">
                        Select Division
                    </option>

                    @foreach (var division
                    in filteredDivisions)
                    {
                        @* <option value="@division.DivisionId"> *@

                        @*     @division.DivisionName *@

                        @*     - *@

                        @*     Semester *@
                        @*     @division.Semester.SemesterNo *@

                        @* </option> *@

                        <option value="@division.DivisionId">

                            @division.DivisionName

                        </option>
                    }

                </select>

            </div>

            <!-- ROOM -->

            <div class="form-group">

                <label>
                    Room
                </label>

                <select class="form-control"
                        @bind="allocation.RoomId">

                    <option value="0">
                        Select Room
                    </option>

                    @foreach (var room in rooms)
                    {
                        <option value="@room.RoomId">

                            @room.RoomName

                            -

                            @room.Department.DepartmentName

                        </option>
                    }

                </select>

            </div>

        </div>

        <!-- BUTTON -->
        @if (!isEditMode)
        {
            <button class="add-btn"
                    @onclick="SaveAllocation">

                Add Allocation

            </button>
        }
        else
        {
            <div class="btn-group-custom">

                <button class="update-btn"
                        @onclick="SaveAllocation">

                    Update Allocation

                </button>

                <button class="cancel-btn"
                        @onclick="CancelEdit">

                    Cancel

                </button>

            </div>
        }

    </div>

    <!-- TABLE -->

    <div class="allocation-table-card">

        <table class="allocation-table">

            <thead>

                <tr>

                    <th>
                        Semester
                    </th>

                    <th>
                        Division
                    </th>

                    <th>
                        Room
                    </th>

                    <th>
                        Department
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (allocations.Any())
                {
                    @foreach (var item
                   in allocations)
                    {
                        <tr>

                            <td>

                                Semester
                                @item.Semester.SemesterNo

                            </td>

                            <td>

                                @item.Division.DivisionName

                            </td>

                            <td>

                                @item.Room.RoomName

                            </td>

                            <td>

                                @item.Room.Department.DepartmentName

                            </td>

                            <td>

                                <button class="edit-btn"
                                        @onclick="() =>
                                        EditAllocation(item.AllocationId)">

                                    Edit

                                </button>

                                <button class="delete-btn"
                                        @onclick="() =>
                                        DeleteAllocation(item.AllocationId)">

                                    Delete

                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="no-data">

                            No allocation found

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@if (showToast)
{
    <div class="custom-toast
         @(isErrorToast
            ? "error-toast"
            : "success-toast")">

        @toastMessage

    </div>
}

@code {

    private List<DivisionRoomAllocation>
        allocations = new();

    private List<Semester>
        semesters = new();

    private List<Division>
        divisions = new();

    private List<Division>
        filteredDivisions = new();

    private List<Room>
        rooms = new();

    private DivisionRoomAllocation
        allocation = new();

    private bool isEditMode = false;

    private int editId;

    private int LoggedInUserId;

    private string toastMessage = "";

    private bool showToast = false;

    private bool isErrorToast = false;



    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        LoggedInUserId =
            Convert.ToInt32(user.FindFirst(ClaimTypes.NameIdentifier)?.Value);

        var courseId = SessionState.CourseId;

        if (courseId == null || courseId == 0)
            return;

        // 🔥 Load sequentially (SAFE for Blazor)
        semesters = await AllocationRepo.GetSemestersByCourseAsync(courseId.Value);
        divisions = await AllocationRepo.GetDivisionsAsync(LoggedInUserId);
        rooms = await AllocationRepo.GetRoomsAsync(LoggedInUserId);
        allocations = await AllocationRepo.GetAllAsync(LoggedInUserId);
    }



    private void OnSemesterChanged(
        ChangeEventArgs e)
    {
        allocation.SemesterId =
            Convert.ToInt32(e.Value);

        filteredDivisions =
            divisions

            .Where(x =>
                x.SemesterId
                == allocation.SemesterId)

            .ToList();
    }



