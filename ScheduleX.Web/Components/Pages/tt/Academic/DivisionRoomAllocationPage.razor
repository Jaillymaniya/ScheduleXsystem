    private bool showToast = false;

    private bool isErrorToast = false;

    private bool showDeallocateModal = false;

    private int oldAllocationId = 0;

    private string oldSemesterName = "";

    protected override async Task OnInitializedAsync()
    {
        SessionState.OnChange += ReloadData;

