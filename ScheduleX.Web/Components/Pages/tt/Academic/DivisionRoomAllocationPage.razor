        }
    }

    void GoNext()
    {
        Nav.NavigateTo(
            "/tt/Configuration/schedule-configuration");
    }

    public void Dispose()
    {
        SessionState.OnChange -= ReloadData;
    }

    private string GetRoomTypeText(RoomTypeEnum type)
    {
        return type switch
        {
            RoomTypeEnum.Classroom => "Classroom",
            RoomTypeEnum.Lab => "Lab",
            _ => "Unknown"
        };
    }
