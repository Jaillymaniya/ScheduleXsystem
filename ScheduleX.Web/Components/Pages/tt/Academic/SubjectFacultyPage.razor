    // =====================================================
    // TOAST
    // =====================================================

    async void ShowToast(
        string message,
        bool error)
    {
        try
        {
            toastMessage = message;

            isError = error;

            showToast = true;

            StateHasChanged();

            await Task.Delay(3000);

            showToast = false;

            StateHasChanged();
        }
        catch
        {
        }
    }

